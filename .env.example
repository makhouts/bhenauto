# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public site
NEXT_PUBLIC_SITE_URL=https://bhenauto.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.bhenauto.com
SERVER_ACTION_ALLOWED_ORIGINS=bhenauto.com,www.bhenauto.com

# Administration
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
WORKSHOP_SCREEN_TOKEN=replace-with-a-long-random-token

# Cloudflare R2
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=replace-me

# Email and form protection
SMTP_USER=info@bhenauto.com
SMTP_PASS=replace-me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me

# Scheduled jobs and privacy-safe analytics
CRON_SECRET=replace-with-at-least-16-random-characters
ANALYTICS_HASH_SALT=replace-with-at-least-16-random-characters

# AutoScout24 integration (optional as a group)
AUTOSCOUT24_USERNAME=
AUTOSCOUT24_PASSWORD=
AUTOSCOUT24_CUSTOMER_ID=
AUTOSCOUT24_MARKETPLACE=be
AUTOSCOUT24_CULTURE=nl-BE

# Optional image analysis
GEMINI_API_KEY=
